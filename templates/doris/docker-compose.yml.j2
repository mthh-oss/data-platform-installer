services:
{% for fe in fe_nodes %}
  doris-fe-{{ fe.id }}:
    image: apache/doris:fe-{{ image_tag }}
    container_name: {{ _project }}_doris-fe-{{ fe.id }}
    hostname: doris-fe-{{ fe.id }}
    environment:
      - FE_SERVERS={{ fe_servers }}
      - FE_ID={{ fe.fe_id }}
    ports:
      - "{{ fe.http_port }}:8030"
      - "{{ fe.query_port }}:9030"
    volumes:
      - doris_fe_meta_{{ fe.id }}:/opt/apache-doris/fe/doris-meta
    networks:
      - dpi_net
    labels:
      dpi.host_id: "{{ fe.host_id }}"
      dpi.host_ip: "{{ fe.ip }}"
      dpi.role: "fe"
{% endfor %}

{% for be in be_nodes %}
  doris-be-{{ be.id }}:
    image: apache/doris:be-{{ image_tag }}
    container_name: {{ _project }}_doris-be-{{ be.id }}
    hostname: doris-be-{{ be.id }}
    depends_on:
{% for fe in fe_nodes %}
      - doris-fe-{{ fe.id }}
{% endfor %}
    environment:
      - FE_SERVERS={{ fe_servers }}
      - BE_ADDR={{ be.ip }}:9050
    ports:
      - "{{ be.web_port }}:8040"
    volumes:
      - doris_be_storage_{{ be.id }}:/opt/apache-doris/be/storage
    networks:
      - dpi_net
    labels:
      dpi.host_id: "{{ be.host_id }}"
      dpi.host_ip: "{{ be.ip }}"
      dpi.role: "be"
{% endfor %}

volumes:
{% for fe in fe_nodes %}
  doris_fe_meta_{{ fe.id }}:
{% endfor %}
{% for be in be_nodes %}
  doris_be_storage_{{ be.id }}:
{% endfor %}

networks:
  dpi_net:
    driver: bridge
